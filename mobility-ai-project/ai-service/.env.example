# ---------------------------------------------------------------------------
# 모빌리티 AI 서비스 환경변수 예시
# 사용법: cp .env.example .env  후 필요한 값만 수정한다.
# 모든 값은 app/config.py 의 Settings 가 접두사 없이 그대로 읽는다.
# ---------------------------------------------------------------------------

# --- 서버 ---
APP_NAME=mobility-ai-service
APP_VERSION=1.0.0
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
# true 면 /docs, /redoc 노출 (운영에서는 false 권장)
ENABLE_DOCS=true

# --- CORS (쉼표 구분) ---
# 프론트엔드(5173)와 백엔드(8080)가 직접 호출할 수 있게 허용한다.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173

# --- 모델 가중치 경로 ---
# 파일이 없으면 자동으로 OpenCV 기반 결정적 폴백이 동작한다(서비스 중단 없음).
MODEL_DIR=./models
DETECTOR_WEIGHTS=./models/plate_yolo_nano.pt
DETECTOR_ONNX=./models/plate_yolo_nano.onnx
CRNN_WEIGHTS=./models/crnn_ctc_kr.pt
ATTENTION_WEIGHTS=./models/attention_ocr_kr.pt
PDM_ANOMALY_WEIGHTS=./models/pdm_isoforest.joblib
PDM_FAILURE_WEIGHTS=./models/pdm_rf.joblib
PDM_RUL_WEIGHTS=./models/pdm_lstm_rul.pt

# --- 기본 선택 모델 ---
DEFAULT_DETECTOR=yolo
DEFAULT_RECOGNIZER=crnn
DEFAULT_MIN_CONF=0.25

# --- 추론 파라미터 ---
# cpu | cuda. cuda 를 적더라도 torch 가 없거나 GPU 가 없으면 cpu 로 강등된다.
DEVICE=cpu
# OpenMP/torch 스레드 수. 0 이면 자동(코어 수).
TORCH_THREADS=4
# NMS IoU 임계값
NMS_IOU=0.45
# 검출기 입력 한 변 크기(letterbox 정사각)
DETECT_IMG_SIZE=640
# OCR 입력 크기 (높이 x 너비)
OCR_IMG_HEIGHT=32
OCR_IMG_WIDTH=160
# 업로드 허용 최대 바이트 (기본 12MB)
MAX_UPLOAD_BYTES=12582912
# 다중 프레임 융합 시 최대 프레임 수
MAX_FRAMES=12

# --- 품질 임계값 ---
# 라플라시안 분산이 이 값보다 작으면 블러로 판단
QUALITY_BLUR_MIN=60.0
# 평균 밝기 허용 범위
QUALITY_BRIGHTNESS_MIN=40.0
QUALITY_BRIGHTNESS_MAX=215.0
# 번호판 가로 픽셀폭이 이 값보다 작으면 판독 불가로 본다
QUALITY_PLATE_PX_MIN=72

# --- 신뢰도 임계값 ---
# 최종 신뢰도가 이 값 미만이면 status=LOW_CONFIDENCE
LOW_CONF_THRESHOLD=0.55

# --- PdM ---
PDM_MODEL_VERSION=pdm-ensemble-1.0.0
