# ---------------------------------------------------------------------------
# 모빌리티 비전 AI 프로젝트 환경 변수 예시
# 사용법: 이 파일을 .env 로 복사한 뒤 값을 채운다.
#         cp .env.example .env
# ---------------------------------------------------------------------------

# PostgreSQL
POSTGRES_DB=mobility_ai
POSTGRES_USER=mobility
POSTGRES_PASSWORD=mobility123
POSTGRES_PORT=5432

# Backend (Spring Boot)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mobility_ai
DB_USER=mobility
DB_PASSWORD=mobility123
SERVER_PORT=8080
# JWT 서명 키: 반드시 32바이트(256비트) 이상이어야 한다. 운영 환경에서는 교체할 것.
JWT_SECRET=change-this-secret-key-at-least-32-bytes-long
JWT_EXPIRES_SECONDS=3600
# AI 추론 서비스 주소
AI_SERVICE_BASE_URL=http://localhost:8000
# 업로드 이미지 저장 경로
UPLOAD_DIR=./data/uploads

# AI service (FastAPI)
AI_HOST=0.0.0.0
AI_PORT=8000
# CPU 추론에 사용할 스레드 수 (물리 코어 수 이하 권장)
AI_TORCH_THREADS=4
# 가중치 파일 경로 (없으면 고전 영상처리 폴백으로 동작)
AI_DETECTOR_WEIGHTS=./models/plate_yolo.pt
AI_RECOGNIZER_WEIGHTS=./models/plate_crnn.pt
AI_MIN_CONFIDENCE=0.25

# Frontend (Vite)
VITE_API_BASE_URL=/api/v1
