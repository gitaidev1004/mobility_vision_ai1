# 프론트엔드 환경변수 예시 파일 (.env 로 복사해서 사용)
# Vite 는 VITE_ 로 시작하는 변수만 클라이언트 번들에 노출한다.

# API 베이스 경로. 기본값은 Vite 프록시를 사용하는 상대 경로.
VITE_API_BASE_URL=/api/v1

# 개발용 백엔드 주소(vite.config.js 프록시 타깃과 일치시킨다)
VITE_BACKEND_ORIGIN=http://localhost:8080

# 주차장 전체 수용 대수(백엔드 /parking/status 가 응답하지 못할 때의 표시용 기본값)
VITE_PARKING_CAPACITY=120

# 화면 자동 갱신 주기(밀리초). 0 이면 자동 갱신하지 않는다.
VITE_DASHBOARD_REFRESH_MS=30000
